# Copy to .env.production. Never commit that file. Passwords should be URL-safe random strings.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=https://your-real-domain
TLS_CERT_DIR=./certs
AI_PRODUCTION_ENABLED=false
DASHSCOPE_API_KEY=
WX_APPID=
WX_SECRET=

# P1: durable jobs require scheduler; quota day is UTC
SCHEDULER_ENABLED=true
AI_USER_DAILY_QUOTA=100
AI_PROJECT_CONCURRENCY=2
# AI_PRICES={"model-name":{"input":0,"output":0}} (CNY/million tokens; set actual contracted rates)
