# ===== 运行环境 =====
APP_ENV=dev                                   # dev/test/prod；prod 启用全部生产准入校验
APP_TIMEZONE=Asia/Shanghai                    # 接口时间输出所用时区

# ===== 数据库 / 缓存 =====
DATABASE_URL=sqlite:///./data/app.db          # prod 必须为 postgresql+psycopg://user:pass@host:5432/db
REDIS_URL=                                    # 空则限流/幂等/去重降级为进程内实现（启动日志告警）

# ===== 令牌 =====
JWT_SECRET=dev-secret-change-me               # prod 下等于示例值或长度<32 则拒绝启动
ACCESS_TOKEN_MINUTES=120                       # access token 有效期（分钟）
REFRESH_TOKEN_DAYS=14                           # refresh token 有效期（天）

# ===== 开发登录（仅 dev 可开） =====
DEV_LOGIN_ENABLED=false                        # 仅 APP_ENV=dev 时可置 true；prod 强制 false 且不注册路由。
                                               # 小程序联调需要登录页测试账号直点时，手动改为 true（P0-2 三重防护之一）
DEV_LOGIN_ALLOWED_IPS=127.0.0.1,::1            # dev-login/dev-accounts 允许的请求来源 IP 白名单（逗号分隔）；
                                               # 不在名单内的请求一律 404（P0-2）。真机联调时按需追加局域网 IP，
                                               # 条目支持尾缀通配（如 192.168.1.* 放行整个网段，手机 IP 不固定时用）
DEV_SEED_PASSWORD=                             # 种子账号密码（仅 dev/test 使用）；空则随机生成并写入 data/seed_credentials.txt
                                               # 生产必须显式设置：≥10 位，含大小写字母/数字/符号中至少三类（如 Demo@Seed2026!），
                                               # 且不得命中弱口令黑名单（123456 等会被强度校验拒绝）

# ===== 文件存储 =====
STORAGE_BACKEND=local                          # local/s3
STORAGE_LOCAL_DIR=./storage                    # 本地存储根目录
S3_ENDPOINT=                                   # s3 模式：对象存储 endpoint（MinIO/OSS 兼容）
S3_BUCKET=                                     # s3 模式：桶名
S3_AK=                                         # s3 模式：Access Key
S3_SK=                                         # s3 模式：Secret Key
S3_REGION=                                     # s3 模式：区域
SIGNED_URL_TTL_SECONDS=300                     # s3 签名 URL 有效期（秒），≤300
WATERMARK_ENABLED=true                         # 是否对现场照片叠加水印
MAX_UPLOAD_MB=20                               # 单文件上传大小上限（MB）
EXIF_MAX_SKEW_MINUTES=120                      # 拍摄时间与接收时间偏差阈值（分钟），超过标存证异常

# ===== AI =====
DASHSCOPE_API_KEY=                             # 通义千问 API Key；prod 下为空则拒绝启动（禁止 mock）
AI_REVIEW_THRESHOLD=0.6                         # 置信度低于该值时强制人工复核说明
AI_DAILY_QUOTA=500                             # 每项目每日 AI 判别次数上限
AI_RECALL_ALERT=0.7                             # 召回率连续 7 天低于该值触发质量告警

# ===== 微信 / 短信 =====
WX_APPID=                                      # 小程序 AppID；prod 必填，启动自检会拒绝缺失配置
WX_SECRET=                                     # 小程序 AppSecret；prod 必填，服务端以它校验 wx.login code
WX_SUBSCRIBE_TEMPLATE_ORDER=                   # 订阅消息模板 ID：工单相关
WX_SUBSCRIBE_TEMPLATE_OVERDUE=                 # 订阅消息模板 ID：超期相关
SMS_PROVIDER=                                  # 短信服务商标识（空则短信通道跳过）
SMS_AK=                                        # 短信 Access Key
SMS_SK=                                        # 短信 Secret Key
SMS_SIGN=                                      # 短信签名
SMS_TEMPLATE_CODE=                             # 验证码短信模板 ID（登录/绑定验证码；通知类短信模板 ID 存 notification_templates.sms_template_code）
SCHEDULER_ENABLED=true                         # 定时任务总开关；测试/单机排查可置 false

# ===== 网络 / 日志 =====
CORS_ORIGINS=http://localhost:5173             # 允许的跨域来源，逗号分隔；prod 不得含 localhost/127.0.0.1
LOG_LEVEL=INFO                                 # 日志级别
LOG_FORMAT=json                                # json（生产结构化采集）/text（本地可读）
SENTRY_DSN=                                     # 可选：Sentry 上报 DSN

# ===== 其他 =====
INIT_DEMO_DATA=1                               # 1 注入演示种子；冒烟测试需空表时设为 0

# P1: durable jobs require scheduler; quota day is UTC
SCHEDULER_ENABLED=true
AI_USER_DAILY_QUOTA=100
AI_PROJECT_CONCURRENCY=2
# AI_PRICES={"model-name":{"input":0,"output":0}} (CNY/million tokens; set actual contracted rates)
