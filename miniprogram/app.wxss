/* 全局公共样式：rpx 布局，色板按总纲第 8 章 */
page {
  background: #F5F7FA;
  color: #1A2634;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 主按钮 */
.btn-primary {
  background: #1E5FD0;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 20rpx 0;
}
.btn-primary::after {
  border: none;
}

/* 次要按钮（描边） */
.btn-ghost {
  background: #ffffff;
  color: #1E5FD0;
  border: 1rpx solid #1E5FD0;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 20rpx 0;
}
.btn-ghost::after { border: none; }

/* 认证类页面公共布局（登录/绑定/改密共用） */
.login-wrap { padding: 60rpx 32rpx; }
.hero { text-align: center; padding: 60rpx 0 48rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; color: #1E5FD0; }
.hero-sub { margin-top: 16rpx; font-size: 26rpx; color: #5B6B7D; }

/* 标签基类与语义色 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.tag-primary { background: rgba(30, 95, 208, 0.1); color: #1E5FD0; }
.tag-warn { background: rgba(230, 162, 60, 0.12); color: #E6A23C; }
.tag-danger { background: rgba(229, 101, 42, 0.12); color: #E5652A; }
.tag-success { background: rgba(46, 125, 58, 0.12); color: #2E7D3A; }
.tag-info { background: rgba(91, 107, 125, 0.12); color: #5B6B7D; }

/* 空状态（统一文案「暂无数据」） */
.empty {
  text-align: center;
  color: #5B6B7D;
  font-size: 26rpx;
  padding: 120rpx 0;
}

/* chips 标签选择器（问询/记录筛选等） */
.chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #F5F7FA;
  color: #5B6B7D;
  font-size: 26rpx;
  border: 1rpx solid transparent;
}
.chip-active {
  background: rgba(30, 95, 208, 0.08);
  color: #1E5FD0;
  border-color: #1E5FD0;
}

/* 次要文字与字号层级 */
.muted { color: #5B6B7D; }
.title { font-size: 32rpx; font-weight: 600; color: #1A2634; }
.desc { font-size: 26rpx; color: #5B6B7D; }
