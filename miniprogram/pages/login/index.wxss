.login-wrap {
  padding: 60rpx 32rpx;
}

.hero {
  text-align: center;
  padding: 60rpx 0 48rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E5FD0;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #5B6B7D;
}

.dev-tip {
  font-size: 24rpx;
  color: #E6A23C;
  margin-bottom: 20rpx;
}

.dev-error {
  font-size: 24rpx;
  color: #D32F2F;
  background: #FDECEC;
  border-radius: 8rpx;
  padding: 16rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.account-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F5F7FA;
}
.account-item:last-child {
  border-bottom: none;
}
.account-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2634;
}
.account-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.wx-btn {
  margin-top: 60rpx;
}

/* 开发者模式测试账号卡片：与上方“手机号验证码登录”按钮保持间距（仅本页生效） */
.login-wrap .card {
  margin-top: 48rpx;
}
