/* 提示条：错误（微信未配置）/ 信息（验证码已发送或 dev 自动填入） */
.hint-bar {
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.hint-error { background: #FDECEC; color: #D32F2F; }
.hint-info { background: rgba(30, 95, 208, 0.08); color: #1E5FD0; }

.form-item { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: #5b6b7d; margin-bottom: 12rpx; }
.form-input {
  width: 100%; box-sizing: border-box; height: 88rpx; padding: 0 24rpx;
  background: #f5f7fa; border-radius: 12rpx; font-size: 30rpx;
}
.code-row { display: flex; align-items: center; }
.code-input { flex: 1; }
.code-btn { margin-left: 16rpx; width: 220rpx; flex-shrink: 0; }
