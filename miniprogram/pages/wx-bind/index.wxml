<view class="login-wrap">
  <view class="hero">
    <view class="hero-title">手机号验证码登录</view>
    <view class="hero-sub">独立登录方式，需管理员登记手机号并配置短信服务；微信登录无需此步骤</view>
  </view>

  <view wx:if="{{wxConfigError}}" class="hint-bar hint-error">{{wxConfigError}}</view>
  <view wx:if="{{smsHint}}" class="hint-bar hint-info">{{smsHint}}</view>

  <view class="card">
    <view wx:if="{{!ready}}" class="empty">正在加载…</view>
    <block wx:else>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="请输入登记的手机号"
               value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="form-item">
        <text class="form-label">验证码</text>
        <view class="code-row">
          <input class="form-input code-input" type="number" maxlength="6" placeholder="6 位验证码"
                 value="{{smsCode}}" bindinput="onCodeInput" />
          <button class="btn-ghost code-btn" bindtap="sendCode" disabled="{{countdown>0}}">
            {{countdown>0 ? countdown+'s' : '获取验证码'}}
          </button>
        </view>
      </view>
      <button class="btn-primary" bindtap="submit">手机号登录</button>
    </block>
  </view>
</view>
