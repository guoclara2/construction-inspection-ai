/* 消息中心页样式 */
.page-wrap {
  padding: 24rpx 24rpx 40rpx;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.top-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2634;
}
.read-all-btn {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(30, 95, 208, 0.08);
  color: #1E5FD0;
  font-size: 26rpx;
}
.read-all-disabled {
  opacity: 0.5;
}

/* 消息卡片：未读左上角圆点 */
.msg-card {
  position: relative;
}
.msg-unread {
  border-left: 6rpx solid #1E5FD0;
}
.msg-dot {
  display: none;
}
.msg-dot-on {
  display: block;
  position: absolute;
  left: -3rpx;
  top: -3rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #1E5FD0;
}
.msg-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.msg-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2634;
}
/* P2-1：待办已失效（工单闭环）灰色标签 */
.msg-stale {
  font-size: 22rpx;
  font-weight: 400;
  color: #98A3B3;
}
.msg-time {
  font-size: 24rpx;
  white-space: nowrap;
}
.msg-content {
  margin-top: 8rpx;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 通道推送状态（P06 §2.4.3）：已推送微信的标识 */
.msg-channel {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A97A6;
}
.msg-channel::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #34C77B;
  margin-right: 8rpx;
  vertical-align: middle;
}

.list-end {
  text-align: center;
  font-size: 24rpx;
  padding: 20rpx 0;
}
