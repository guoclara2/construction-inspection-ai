/* 智能巡查首页样式 */
.page-wrap {
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

.project-card {
  padding: 32rpx 24rpx;
}
.project-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2634;
}
.project-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.entry-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.entry-btn {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 36rpx 24rpx;
}
.entry-primary {
  background: #1E5FD0;
}
.entry-primary .entry-title {
  color: #ffffff;
}
.entry-desc-light {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
.entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2634;
}
.entry-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 10rpx 4rpx 20rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.record-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2634;
  flex: 1;
  margin-right: 16rpx;
}
.record-time {
  font-size: 24rpx;
  white-space: nowrap;
}
.record-tags {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.project-switch {
  float: right;
  font-size: 24rpx;
  color: #1e5fd0;
  font-weight: 400;
}
