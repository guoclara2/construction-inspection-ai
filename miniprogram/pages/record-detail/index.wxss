/* 巡查记录详情页样式 */
.page-wrap {
  padding: 24rpx 24rpx 40rpx;
}

.section-label {
  font-size: 26rpx;
  color: #5B6B7D;
  margin-bottom: 16rpx;
}

/* 现场位置 */
.location-text {
  font-size: 26rpx;
  color: #1A2634;
  line-height: 1.7;
}

/* 照片缩略图 */
.thumb-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.thumb {
  width: 180rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: #F5F7FA;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2634;
}
.item-basis {
  font-size: 22rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}
.item-tags {
  margin-top: 16rpx;
}

.photo {
  width: 100%;
  border-radius: 12rpx;
  background: #F5F7FA;
}

/* 照片存证信息行（P04 §2.5.5） */
.evidence-line {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.evidence-line .muted {
  font-size: 22rpx;
}

/* AI 结果卡片（与填报页一致的展示契约） */
.ai-card {
  position: relative;
}
.ai-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #E6A23C;
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 12rpx 0 12rpx;
}
.ai-verdict {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.ai-danger { color: #E5652A; }
.ai-success { color: #2E7D3A; }
.ai-warn { color: #E6A23C; }
.ai-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.ai-confidence {
  font-size: 24rpx;
}
.ai-conf-success { color: #2E7D3A; font-weight: 600; }
.ai-conf-warn { color: #E6A23C; font-weight: 600; }
.ai-confidence-hint {
  font-size: 22rpx;
  color: #B26A00;
  background: #FDF3E7;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.ai-block {
  margin-top: 20rpx;
}
.ai-label {
  font-size: 22rpx;
  color: #5B6B7D;
  margin-bottom: 8rpx;
}
.ai-text {
  font-size: 26rpx;
  color: #1A2634;
  line-height: 1.7;
}
.ai-quote {
  font-size: 24rpx;
  color: #1A2634;
  line-height: 1.7;
  background: #F5F7FA;
  border-left: 6rpx solid #1E5FD0;
  padding: 14rpx 18rpx;
  border-radius: 0 8rpx 8rpx 0;
}
.ai-footer {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #5B6B7D;
  text-align: center;
}

/* 人工确认 */
.human-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.human-meta {
  font-size: 24rpx;
}
.note-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #1A2634;
  background: #F5F7FA;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  line-height: 1.7;
}

/* 关联工单 */
.related-card {
  padding: 28rpx 24rpx;
}
.related-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.related-text {
  font-size: 28rpx;
  color: #1E5FD0;
}
